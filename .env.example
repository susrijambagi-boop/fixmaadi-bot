# Copy this file to .env and fill in real values. Never commit .env.

# Resend (email/CSAT dispatch) — https://resend.com/api-keys
RESEND_API_KEY=

# Gemini AI (conversational flow) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Admin dashboard login (HTTP Basic Auth). Required — without both set, the
# dashboard and all admin APIs return 503 and refuse access rather than
# opening unauthenticated. Pick a real password, not a placeholder.
ADMIN_USERNAME=
ADMIN_PASSWORD=

PORT=3000
NODE_ENV=production
