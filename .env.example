# Copy this file to .env and fill in real values. Never commit .env.

# Resend (email/CSAT dispatch) — https://resend.com/api-keys
RESEND_API_KEY=

# Gemini AI (conversational flow) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Admin dashboard login (HTTP Basic Auth). Required — without both set, the
# dashboard and all admin APIs return 503 and refuse access rather than
# opening unauthenticated. Pick a real password, not a placeholder.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# MongoDB Atlas connection string — required on hosts with an ephemeral disk
# (e.g. Render's free tier), since without it bookings/vendors/customers are
# wiped on every restart. Leave blank for local dev to use the local
# database.json file instead. Get this from Atlas → Database → Connect →
# Drivers, after creating a free M0 cluster and a database user.
MONGODB_URI=

PORT=3000
NODE_ENV=production
